# What to EXCLUDE from the published npm tarball.
# package.json `files` is the allowlist; this file is a safety net for items
# that get accidentally promoted into included directories.

# Source — we ship the compiled dist/ instead
src/
tests/
*.test.ts
*.spec.ts

# Build state
tsconfig*.json
*.tsbuildinfo
.eslintrc*
.prettierrc*
vitest.config*

# Bundle (downloaded at install time, never published)
references/terraform-providers/
npm/bundle/
npm/.version

# Repo housekeeping
.changeset/
.github/
.gitignore
.npmignore
docs/
evals/
PORT-ROADMAP.md

# Editor state
.vscode/
.idea/
.DS_Store
