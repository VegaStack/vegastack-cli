node_modules/
dist/
*.log
*.tsbuildinfo
.DS_Store

# Registry content staged for local dev — never commit generated corpus data
references/registry/
npm/registry/
npm/.version

# Build artifacts
*.tar.gz
*.tgz
*.zip
*.sha256

# Re-allow test fixture tarballs (precomputed inputs for cross-platform tests
# where building the tarball at runtime would diverge between BSD vs GNU tar).
!tests/fixtures/**/*.tar.gz
!tests/fixtures/**/*.tgz

# Editor state
.vscode/
.idea/
.claude/claude-code-chat-images/

# Test workspace
tests/.workspace/
tests/.cache/
exports/

# Changeset draft state
.changeset/_*.md

# Local env
.env
.env.local
