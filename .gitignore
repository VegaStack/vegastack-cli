node_modules/
dist/
*.log
*.tsbuildinfo
.DS_Store

# Bundle staged for local dev — never commit, always download
references/terraform-providers/
npm/bundle/
npm/.version

# Build artifacts
*.tar.gz
*.tgz
*.zip
*.sha256

# Re-allow test fixture tarballs (precomputed inputs for cross-platform tests
# where building the tarball at runtime would diverge between BSD vs GNU tar).
!tests/fixtures/**/*.tar.gz
!tests/fixtures/**/*.tgz

# Editor state
.vscode/
.idea/

# Test workspace
tests/.workspace/
tests/.cache/

# Changeset draft state
.changeset/_*.md

# Local env
.env
.env.local
