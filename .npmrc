# vegastack-cli — npm config
#
# These settings are read by npm when running `npm install`, `npm publish`,
# `npm audit`, etc.
#
# === Registry routing (v0.1 internal — GitHub Packages) ===
# All `@vegastack`-scoped packages are published to GitHub Packages instead
# of the public npm registry. This includes both publishing FROM this repo
# (npm publish) and consuming sibling packages (npm install).
#
# CI (publish-internal.yml) sets NODE_AUTH_TOKEN=${{ secrets.GITHUB_TOKEN }}.
# Local dev uses a personal access token (PAT) with read:packages scope,
# placed in ~/.npmrc — never commit a PAT to this file.
#
# === Lint settings ===
#   audit-level=moderate     fail `npm audit` on moderate or worse advisories
#   fund=false               silence the "looking for funding" output
#   loglevel=warn            errors + warnings only

@vegastack:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

audit-level=moderate
fund=false
loglevel=warn
