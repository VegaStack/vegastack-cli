# vegastack-cli — npm config
#
# These settings are read by npm when running `npm install`, `npm publish`,
# `npm audit`, etc.
#
# === Public npm publishing ===
# @vegastack/cli publishes to the public npm registry through GitHub Actions
# trusted publishing with npm provenance. Do not commit npm auth tokens here.
@vegastack:registry=https://registry.npmjs.org
#
# === Lint settings ===
#   audit-level=moderate     fail `npm audit` on moderate or worse advisories
#   fund=false               silence the "looking for funding" output
#   loglevel=warn            errors + warnings only

audit-level=moderate
fund=false
loglevel=warn
