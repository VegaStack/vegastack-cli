    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.11.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.15.0",
    "@cloudflare/workers-types": "4.20260426.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "wrangler": "4.85.0"
  },
  "overrides": {
    "hono": "^4.12.16",
    "ip-address": "^10.1.1"
  }
}
