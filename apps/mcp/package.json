{
  "name": "@vegastack/mcp-server",
  "version": "0.1.13-next.2",
  "private": true,
  "description": "vegastack-cli Remote MCP server — Cloudflare Workers + Agents SDK. Exposes `vegastack ask --pack terraform --tf-provider <provider>` discovery (and friends) to any MCP-aware coding agent over StreamableHTTP/SSE.",
